---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="This page doesn't exist on Mola Faleti's site. The homepage links to everything that's here."
  noindex
>
  <div class="wrap page">
    <h1>That page doesn’t exist</h1>
    <p>The link may be mistyped, or the page may have moved.</p>
    <p class="links">
      <a class="arrow-link" href="/">Go to the homepage</a>
      <a class="arrow-link" href="/resume/">See the resume</a>
    </p>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(var(--s-6), 5vw, var(--s-8));
  }

  p {
    margin-top: var(--s-4);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-5);
  }
</style>
