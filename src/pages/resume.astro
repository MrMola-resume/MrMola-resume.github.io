---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

// Transcribed from public/resume/Ademola-Faleti-Resume.pdf (September 2026), with light copy
// fixes (consistent tense and voice, spelling of Alter Domus, FTA's name). The phone number
// is in the PDF only. Keep the two in sync.
---

<Base
  title="Resume"
  description="Resume of Ademola (Mola) Faleti: enterprise implementation, syndicated loans, procurement, and vendor management at Alter Domus, the RTA, and ComEd. PDF download."
>
  <div class="wrap page">
    <header class="page-head">
      <h1>Resume</h1>
      <a class="btn" href={SITE.resumePdf}>Download PDF (updated September 2026)</a>
    </header>

    <article class="resume" aria-label="Resume of Ademola Faleti">
      <header class="resume-name">
        <p class="name">Ademola O. Faleti</p>
        <ul class="dot-list small muted">
          <li>Chicago, IL</li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.linkedin}>linkedin.com/in/ademolafaleti</a></li>
          <li><a href="/">mrmola-resume.github.io</a></li>
        </ul>
      </header>

      <section>
        <h2>Experience</h2>

        <div class="entry">
          <div class="line">
            <h3>Alter Domus</h3>
          </div>
          <div class="line role">
            <span>Senior Associate, Syndicated Loans Analyst</span>
            <span class="aside">September 2025 – Present</span>
          </div>
          <ul>
            <li>
              Manages 40 accounts representing $500 million in syndicated loan debt, using Power BI
              to monitor trends, exceptions, and performance.
            </li>
            <li>
              Onboards client deals to the Alter Domus Agency system, working with the Legal and
              Accounting departments to verify and process KYC/AML documents.
            </li>
            <li>
              Reads and interprets credit agreements to extract key terms and requirements, then
              updates the Alter Domus Agency system to keep deal data accurate and compliant.
            </li>
            <li>
              Coordinates deal closings; calculates, invoices, collects, and disburses deal-related
              fees; processes interest and principal payments; and coordinates new borrowings. Uses
              Microsoft Excel to validate loan activity and reconcile portfolio data.
            </li>
            <li>
              Ensures accurate system setup and ongoing maintenance of changing deal attributes
              across the loan lifecycle.
            </li>
            <li>
              Maintains deal commitments and processes ongoing loan activity (rate sets, contract
              rollovers, conversions, prepayments, assignments, and amendments).
            </li>
          </ul>

          <div class="line role">
            <span>Senior Implementation Specialist</span>
            <span class="aside">February 2022 – August 2024</span>
          </div>
          <ul>
            <li>
              <strong>US Central Region Implementation Lead.</strong> Served as team lead for the
              enterprise implementation of Alter Domus’s financial services software, a customer
              relationship management (CRM) and reporting platform with seven modules.
            </li>
            <li>
              <strong>Client Implementation Lead.</strong> Responsible for end-to-end
              implementation of client solutions: requirements development and solution design,
              configuration, and deployment support, including facilitating user acceptance testing
              (UAT), facilitating data migration using AI, and leading end-user, core team, and
              administrator training, with product training materials (videos and guides).
              <ul>
                <li>
                  Led the AI-enabled migration of 20,000 client records, the first deployment of
                  intelligent data conversion within the North American Implementation Group,
                  reducing manual processing risk and accelerating go-live readiness.
                  <a href="/projects/ai-client-migration/">Case study</a>
                </li>
                <li>
                  Led or supported 15 implementations ranging from 3 to 12 months in duration over
                  three years.
                </li>
              </ul>
            </li>
            <li>
              <strong>Enterprise AI Strategy Proposal.</strong> Worked with the Director of Client
              Portals and the Director of Artificial Intelligence to create and present a proposal
              to Alter Domus’s Steering Committee to integrate AI into its systems. The proposal
              identified automation opportunities, risk controls, and scalability benefits across
              client onboarding and data workflows.
              <ul>
                <li>
                  Delivered an executive-ready AI business case and roadmap (use cases, governance,
                  and implementation approach) for Steering Committee review.
                  <a href="/projects/enterprise-ai-strategy/">Case study</a>
                </li>
              </ul>
            </li>
            <li>
              <strong>Client Account Management.</strong> After implementation, managed ongoing
              client relationships to drive product adoption and expanded product usage, and served
              as a customer advocate for the product enhancement roadmap.
              <ul>
                <li>
                  Lead Client Account Manager for four client accounts totaling $3.5M in annual
                  revenue.
                </li>
              </ul>
            </li>
            <li>
              <strong>WalkMe and ServiceNow Integration.</strong> Led the integration of WalkMe and
              ServiceNow into the North American instance of Alter Domus’s proprietary systems,
              improving process efficiency and user experience. Used the ServiceNow help desk to
              escalate client issues to the responsible IT departments.
              <ul>
                <li>
                  Resolved client issues promptly in ServiceNow, and used ServiceNow’s Performance
                  Analytics to track incidents and report metrics to key stakeholders monthly.
                </li>
              </ul>
            </li>
          </ul>
        </div>

        <div class="entry">
          <div class="line">
            <h3>Regional Transportation Authority</h3>
          </div>
          <div class="line role">
            <span>Procurement Analyst</span>
            <span class="aside">December 2017 – January 2022</span>
          </div>
          <ul>
            <li>
              <strong>Buyer.</strong> Led procurements across seven departments within the daily
              operations of the RTA of Northeastern Illinois, and led the ERP implementation for
              the procurement department.
            </li>
            <li>
              <strong>ERP Software Implementation Lead.</strong> Internal project lead for RTA’s
              implementation of the ServiceNow Procurement module. Worked with the business and the
              implementation partner across project management and governance, business
              requirement traceability, security role design, access controls, functional testing,
              user acceptance testing, integration testing, configurable controls, and data
              conversion.
            </li>
            <li>
              <strong>Training and support.</strong> Developed enterprise-wide training materials
              and documentation, led enterprise-wide training sessions for internal stakeholders,
              and led post-implementation support, including post-go-live office hours and system
              defect logging.
            </li>
            <li>
              <strong>Contract management.</strong> Managed critical, high-value contracts on the
              procurement team.
              <ul>
                <li>
                  Oversaw 30 active contracts totaling $6 million to ensure contract terms were
                  upheld (e.g., vendor SLAs and uptime commitments).
                </li>
                <li>
                  Led 15 competitive proposals and bids totaling $4 million, supporting management
                  and vendors throughout the procurement process, including leading RFP development
                  and responses.
                </li>
                <li>
                  Led negotiations with firms to secure favorable offers aligned with the Federal
                  Transit Administration (FTA) governance framework for procuring goods and
                  professional services.
                </li>
                <li>Ensured awarded bidders followed FTA supplier diversity requirements.</li>
              </ul>
            </li>
          </ul>
        </div>

        <div class="entry">
          <div class="line">
            <h3>Commonwealth Edison (ComEd)</h3>
          </div>
          <div class="line role">
            <span>Business Analyst</span>
            <span class="aside">June 2011 – March 2017</span>
          </div>
          <ul>
            <li>
              <strong>Bill Print Vendor Manager.</strong> Oversaw day-to-day operations with
              ComEd’s bill print vendor.
              <ul>
                <li>
                  Served as subject matter expert for the request for proposal (RFP) and
                  implementation processes in selecting and onboarding a new bill print vendor.
                </li>
                <li>
                  Managed $18 million in annual ComEd postage funding, analyzing spend to budget
                  funding more accurately going forward.
                </li>
                <li>
                  Performed quarterly on-site audits to verify printing was done correctly and
                  within the specifications of the service level agreement.
                </li>
                <li>
                  Reviewed the vendor’s SSAE 16/SAS 70 annual audit report with leadership for
                  risk assessment.
                </li>
                <li>
                  Developed a segmentation strategy based on vendor spend and criticality to
                  optimize resource allocation and relationship management.
                </li>
                <li>
                  Worked with the vendor daily to update a list of 600 payment locations, which
                  ComEd call center representatives used to guide customers to the locations
                  closest to them.
                </li>
                <li>
                  Investigated misuse of the vendor portal by ComEd employees in violation of
                  company policy on sensitive personal information, and reported findings back to
                  the vendor.
                </li>
                <li>Facilitated training for new users of the debt collections system.</li>
                <li>Created annual $100,000 contracts for vendor invoicing.</li>
              </ul>
            </li>
          </ul>
        </div>
      </section>

      <section>
        <h2>Related credentials</h2>
        <div class="line">
          <span>ServiceNow Certified System Administrator (CSA)</span>
          <span class="aside">December 2024</span>
        </div>
      </section>

      <section>
        <h2>Education</h2>
        <div class="line">
          <h3>University of Illinois Urbana-Champaign</h3>
        </div>
        <div class="line role">
          <span>Bachelor of Arts, Political Science</span>
        </div>
      </section>
    </article>

    <section class="embed" aria-labelledby="pdf-title">
      <h2 id="pdf-title">PDF version</h2>
      <object
        data={SITE.resumePdf}
        type="application/pdf"
        width="100%"
        height="900"
        title="Ademola Faleti resume (PDF)"
        aria-label="Ademola Faleti resume (PDF)"
      >
        <p>Your browser can't display PDFs inline — <a href={SITE.resumePdf}>download it instead</a>.</p>
      </object>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(var(--s-6), 5vw, var(--s-8));
  }

  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-5);
    margin-bottom: var(--s-6);
  }

  .resume {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(var(--s-5), 5vw, var(--s-8));
  }

  .resume-name {
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }

  .name {
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: var(--s-2);
  }

  section {
    margin-top: var(--s-6);
  }

  .resume h2 {
    font-size: .75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--accent);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .entry + .entry {
    margin-top: var(--s-6);
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--s-4);
  }

  .line h3 {
    font-size: var(--fs-h3);
  }

  .role {
    color: var(--muted);
    font-size: 1rem;
    font-weight: 500;
  }

  ul + .role {
    margin-top: var(--s-4);
  }

  /* Dates: the label role, with tabular figures so stacked dates align. */
  .aside {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    white-space: nowrap;
  }

  .entry ul {
    margin-top: var(--s-2);
    padding-left: 1.2em;
  }

  .entry ul ul {
    margin-top: var(--s-1);
  }

  .entry li {
    max-width: 80ch;
  }

  .entry li + li {
    margin-top: var(--s-2);
  }

  .entry li li + li {
    margin-top: var(--s-1);
  }

  .entry li::marker {
    color: var(--muted);
  }

  .entry strong {
    font-weight: 600;
  }

  .embed {
    margin-top: var(--s-8);
  }

  .embed h2 {
    margin-bottom: var(--s-4);
  }

  .embed object {
    display: block;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .embed object p {
    padding: var(--s-5);
  }

  /* Mobile browsers render inline PDFs blank; the HTML above is the real resume. */
  @media (max-width: 899px) {
    .embed {
      display: none;
    }
  }
</style>
