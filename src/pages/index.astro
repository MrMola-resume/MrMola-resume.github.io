---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Motif from '../components/Motif.astro';
import { SITE } from '../site';

const other = [
  {
    title: 'ServiceNow Procurement Implementation at RTA',
    text: 'Led RTA’s enterprise ServiceNow Procurement implementation across seven departments, covering requirements, testing, data conversion, training, and post-go-live support.',
  },
  {
    title: 'Bill Print Vendor Transition at ComEd',
    text: 'Served as the business SME for selecting and onboarding a new bill-print vendor, from the RFP through implementation, while managing $18M in annual postage funding.',
  },
  {
    title: '$500M Syndicated Loan Portfolio at Alter Domus',
    text: 'Manage 40 syndicated loan accounts representing roughly $500M in debt, handling onboarding, deal closings, cash movements, fees, and ongoing loan activity.',
  },
];
---

<Base band={false} description="Mola Faleti leads enterprise implementations, improves business processes, and helps teams adopt new technology across financial services, public transportation, and utilities. Based in Chicago.">
  <Motif variant="hero">
    <section class="wrap hero" aria-labelledby="hero-title">
      <div class="hero-text">
        <h1 id="hero-title">I build systems that help organizations work better.</h1>
        <p class="lede">
          I’m Ademola (Mola) Faleti. I’ve spent my career leading enterprise implementations,
          improving business processes, and helping teams adopt new technology across financial
          services, public transportation, and utilities. I’m looking for implementation,
          business systems, or technology roles where I can work across teams, solve operational
          problems, and turn better processes into the way the organization actually works.
        </p>
        <div class="actions">
          <a class="btn" href="#work">See my work</a>
          <a class="arrow-link" href="/resume/">Resume</a>
          <a class="arrow-link" href={SITE.linkedin}>LinkedIn</a>
          <a class="arrow-link" href={`mailto:${SITE.email}`}>Email me</a>
        </div>
        <p class="label">Chicago, IL · Implementation · Business Systems · Process Improvement</p>
      </div>
      <div class="hero-photo">
        <img class="headshot" src="/img/headshot.jpg" alt="Mola Faleti" width="470" height="470" loading="eager" fetchpriority="high" />
      </div>
    </section>
  </Motif>

  <section class="wrap section" id="work" aria-labelledby="work-title">
    <h2 id="work-title">Selected work</h2>
    <div class="cards">
      <ProjectCard
        eyebrow="Alter Domus"
        title="AI-enabled migration of 20,000 client records"
        href="/projects/ai-client-migration/"
        summary="Led the North American Implementation Group’s first intelligent data conversion, moving about 20,000 client records into a new CRM in a week and a half, against a four-week manual estimate."
        meta={['AI data conversion', 'CRM', 'Data validation']}
      />
      <ProjectCard
        eyebrow="Alter Domus"
        title="Enterprise AI strategy proposal"
        href="/projects/enterprise-ai-strategy/"
        summary="Worked with the Directors of Client Portals and AI to turn AI ideas into an executive-ready roadmap of use cases, governance, and implementation for the Steering Committee."
        meta={['AI strategy', 'Process analysis', 'Governance']}
      />
    </div>
  </section>

  <section class="wrap section" aria-labelledby="other-title">
    <h2 id="other-title">Other Experience</h2>
    <ul class="other">
      {other.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="about full-bleed" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <img
        src="/img/rio.jpg"
        alt="Mola, seen from behind, looking out over rainforest from a lookout in Rio de Janeiro."
        width="1024"
        height="576"
        loading="lazy"
        decoding="async"
      />
      <div class="about-text">
        <h2 id="about-title">About</h2>
        <p>
          I grew up in Chicago and have spent my career working in utilities, public
          transportation, and financial services. Somewhere along the way I realized the work I
          enjoy most is pretty simple: figuring out why something is harder than it needs to be,
          building a better process, and getting people to actually use it.
        </p>
        <p>
          Outside of work, I run a lot, study Spanish, travel whenever I get the chance, and
          probably spend too much time following Chicago sports. I’m naturally curious, so I’m
          usually learning something, planning the next trip, or trying to solve some problem I’ve
          decided needs solving. If you’re in Chicago, feel free to reach out for lunch, a run, or
          just good conversation.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero ------------------------------------------------------------ */
  .hero {
    display: grid;
    gap: var(--s-6);
    padding-block: clamp(var(--s-7), 7vw, var(--s-9));
  }

  .hero h1 {
    font-size: var(--fs-display);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.03em;
    max-width: 17ch;
  }

  .lede {
    margin-top: var(--s-5);
    max-width: 58ch;
    font-size: 1.125rem;
  }

  /* The drawing fades out behind the text so the copy sits on near-plain ground. Stacked
     (mobile): strong behind the photo at the top, fading out by the headline. */
  :global(.motif--hero svg) {
    --fade: linear-gradient(to bottom, #000 200px, rgb(0 0 0 / .12) 400px);
    -webkit-mask-image: var(--fade);
    mask-image: var(--fade);
  }

  /* Side by side: the content column is centred, so measure from the centre. */
  @media (min-width: 768px) {
    :global(.motif--hero svg) {
      --fade: linear-gradient(to right, rgb(0 0 0 / .12) calc(50% + 40px), #000 calc(50% + 180px));
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
    margin-top: var(--s-6);
  }

  .actions + p {
    margin-top: var(--s-5);
  }

  .hero-photo {
    order: -1;
    width: 100%;
    max-width: 200px;
    margin-inline: auto;
  }

  /* Photo treatment follows the palette: a hairline (navy), bare (charcoal), or an offset
     clay block behind it (earth). */
  .headshot {
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    object-fit: cover;
  }

  :global(:root[data-palette='charcoal']) .headshot {
    border: 0;
  }

  :global(:root[data-palette='earth']) .headshot {
    border: 0;
    box-shadow: 12px 12px 0 #E6CDBE;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 3fr 2fr;
      align-items: center;
      gap: var(--s-8);
    }

    .hero-photo {
      order: 0;
      max-width: 380px;
      margin-inline: auto 0;
    }
  }

  /* Sections -------------------------------------------------------- */
  .section {
    padding-top: var(--section);
  }

  .section > h2 {
    margin-bottom: var(--s-6);
  }

  .cards {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Other Experience ------------------------------------------------ */
  .other {
    display: grid;
    gap: var(--s-4);
    list-style: none;
    padding: 0;
  }

  .other li {
    padding: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .other h3 {
    line-height: 1.3;
  }

  .other p {
    margin-top: var(--s-3);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Three across only when each card has room; a 2-up tablet row would orphan the third. */
  @media (min-width: 900px) {
    .other {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-5);
    }
  }

  /* About ----------------------------------------------------------- */
  .about {
    margin-top: var(--section);
    padding-block: var(--section);
    background: var(--surface);
    border-top: 1px solid var(--rule);
  }

  /* The original is 1024×576; cap its height so it isn't blown up on wide screens. */
  .about img {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 480px;
    object-fit: cover;
    object-position: center 45%;
    border-radius: var(--radius);
  }

  .about-text {
    max-width: var(--measure);
    margin-top: var(--s-7);
  }

  .about-text h2 {
    margin-bottom: var(--s-4);
  }

  .about-text p + p {
    margin-top: var(--s-4);
  }
</style>
