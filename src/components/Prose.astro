---
/** Typographic wrapper for long-form Markdown: case studies and writing. */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure);
  }

  .prose > :global(* + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    margin-top: 2.2em;
  }

  .prose :global(h3) {
    margin-top: 1.8em;
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.6em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(li::marker) {
    color: var(--muted);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: var(--s-5);
    border-left: 2px solid var(--rule);
    color: var(--muted);
  }

  .prose :global(pre) {
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface) !important;
    font-size: 0.9375rem;
    line-height: 1.5;
    overflow-x: auto;
  }

  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
  }

  .prose :global(img) {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  /* Tables: booktabs-style — firm rules at the top, under the header, and at the bottom;
     hairlines between rows; no vertical lines. `display: block` lets a wide table scroll
     on its own instead of widening the page. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(thead th) {
    font-weight: 600;
    vertical-align: bottom;
    border-top: 1px solid var(--muted);
    border-bottom: 1px solid var(--muted);
  }

  /* Browsers centre <th> by default; left-align unless the Markdown set an alignment. */
  .prose :global(th:not([align]):not([style])) {
    text-align: left;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.55em 1.1em;
  }

  .prose :global(:is(th, td):first-child) {
    padding-left: 0;
  }

  .prose :global(:is(th, td):last-child) {
    padding-right: 0;
  }

  .prose :global(tbody td) {
    border-bottom: 1px solid var(--rule);
  }

  .prose :global(tbody tr:last-child td) {
    border-bottom-color: var(--muted);
  }
</style>
