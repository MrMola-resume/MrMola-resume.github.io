---
interface Props {
  eyebrow: string;
  title: string;
  /** Omit to render the card without a link (e.g. before the case study exists). */
  href?: string;
  summary: string;
  meta: string[];
}

const { eyebrow, title, href, summary, meta } = Astro.props;
---

<article class:list={['card', { linked: href }]}>
  <p class="eyebrow">{eyebrow}</p>
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <p class="summary">{summary}</p>
  <ul class="dot-list mono">
    {meta.map((item) => <li>{item}</li>)}
  </ul>
</article>

<style>
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(var(--s-5), 4vw, var(--s-7));
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .linked:hover {
    transform: translateY(-2px);
    border-color: var(--grain-line);
  }

  h3 {
    margin-top: var(--s-3);
    font-size: clamp(1.25rem, 2.4vw, 1.375rem);
    line-height: 1.25;
  }

  h3 a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .linked:hover h3 a {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  /* Make the whole card the click target while keeping one link in the a11y tree. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  h3 a:focus-visible {
    outline: none;
  }

  h3 a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .summary {
    margin-top: var(--s-3);
    max-width: 62ch;
  }

  ul {
    margin-top: var(--s-4);
  }
</style>
