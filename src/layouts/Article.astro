---
import Base from './Base.astro';
import Prose from '../components/Prose.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** The facts shown under the title, joined with `·`. */
    meta?: string[];
    tools?: string[];
    /** The case study linked at the bottom of the page. */
    next?: { href: string; title: string };
  };
}

const { title, description, meta = [], tools = [], next } = Astro.props.frontmatter;

// Fail with a readable message instead of a crash further down.
for (const [field, ok] of [['title', title], ['description', description]] as const) {
  if (!ok) throw new Error(`${Astro.url.pathname}: front matter is missing \`${field}\``);
}
---

<Base title={title} description={description} type="article">
  <article class="wrap article">
    <div class="column">
      <header class="article-head">
        <h1>{title}</h1>
        {meta.length > 0 && (
          <ul class="dot-list meta label">
            {meta.map((item) => <li>{item}</li>)}
          </ul>
        )}
        {tools.length > 0 && (
          <p class="tools label">Tools · {tools.join(', ')}</p>
        )}
      </header>

      <Prose>
        <slot />
      </Prose>

      <nav class="pager small" aria-label="Case studies">
        <a href="/#work">← Selected work</a>
        {next && (
          <a class="next" href={next.href}>
            <span class="label">Next case study</span>
            <span class="next-title">{next.title} →</span>
          </a>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .article {
    padding-top: clamp(var(--s-6), 5vw, var(--s-8));
  }

  .column {
    max-width: var(--measure);
  }

  .article-head {
    margin-bottom: var(--s-6);
  }

  .meta {
    margin-top: var(--s-4);
  }

  .tools {
    margin-top: var(--s-1);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .next {
    display: grid;
    gap: var(--s-1);
    text-align: right;
    margin-left: auto;
    text-decoration: none;
  }

  .next-title {
    font-size: 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .next:hover .next-title {
    text-decoration-thickness: 2px;
  }

  /* Key figures at the top of an Outcome section (raw HTML in the Markdown). */
  .article :global(.figures) {
    display: grid;
    gap: var(--s-4);
    margin: var(--s-5) 0 var(--s-6);
    padding: var(--s-5) 0;
    border-block: 1px solid var(--rule);
  }

  .article :global(.figures div) {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end; /* reversed, so this packs the figures to the top */
    gap: var(--s-1);
  }

  .article :global(.figures dt) {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--muted);
  }

  .article :global(.figures dd) {
    margin: 0;
    font-size: clamp(1.875rem, 4vw, 2.375rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 600px) {
    .article :global(.figures) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-5);
    }
  }
</style>
